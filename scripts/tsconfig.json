{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": "..",
    "paths": {
      "@vitrine72/core": ["packages/core/src/index.ts"],
      "@vitrine72/site-template": ["packages/site-template/src/index.ts"],
      "@vitrine72/qa": ["packages/qa/src/index.ts"]
    }
  },
  "ts-node": {
    "experimentalResolver": true,
    "transpileOnly": true
  },
  "include": ["./**/*.ts", "../packages/*/src/**/*.ts", "../config/**/*.json"]
}
