# Public base URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Clinic WhatsApp in international format, digits only: 55 + DDD + number.
# Leave empty in the demo: links then open WhatsApp without a preset recipient.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Clinic phone for tel: links, same format. Empty = phone links are hidden.
NEXT_PUBLIC_PHONE_NUMBER=

# GA4 measurement ID (G-XXXXXXX). Empty = analytics is a no-op.
NEXT_PUBLIC_GA4_ID=

# "true" only for a real, approved clinic site. Demo stays out of search engines.
NEXT_PUBLIC_ALLOW_INDEXING=false
