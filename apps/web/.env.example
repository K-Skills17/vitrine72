# Google Places
GOOGLE_PLACES_API_KEY=PLACEHOLDER_GOOGLE_PLACES_KEY

# Anthropic
ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_KEY

# Transcription (Groq Whisper)
