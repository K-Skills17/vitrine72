# Ops (NEEDS #15)
OPS_EMAIL_ALLOWLIST=komando@PLACEHOLDER_DOMAIN

# Public config (NEEDS #19, #20)
NEXT_PUBLIC_WHATSAPP=PLACEHOLDER_WHATSAPP
