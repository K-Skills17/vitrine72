NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SUPABASE_SERVICE_ROLE_KEY

# Resend
RESEND_API_KEY=PLACEHOLDER_RESEND_API_KEY
RESEND_FROM=contato@vitrini72.com.br

# Kiwify
KIWIFY_WEBHOOK_SECRET=PLACEHOLDER_KIWIFY_WEBHOOK_SECRET

# Asaas
ASAAS_API_KEY=PLACEHOLDER_ASAAS_API_KEY
ASAAS_WEBHOOK_SECRET=PLACEHOLDER_ASAAS_WEBHOOK_SECRET
