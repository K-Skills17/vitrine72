{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:estetica": "cross-env NEXT_PUBLIC_NICHE=estetica next dev -p 3001",
    "dev:planejados": "cross-env NEXT_PUBLIC_NICHE=planejados next dev -p 3002",
    "build:estetica": "cross-env NEXT_PUBLIC_NICHE=estetica next build",
    "build:planejados": "cross-env NEXT_PUBLIC_NICHE=planejados next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:estetica": "cross-env NEXT_PUBLIC_NICHE=estetica playwright test",
    "test:e2e:planejados": "cross-env NEXT_PUBLIC_NICHE=planejados playwright test"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
